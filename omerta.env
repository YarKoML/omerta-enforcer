# Omerta Enforcer — раскладка сервера.
# Скопируй в /etc/omerta-enforcer.env и заполни своими значениями (README, «Шаг 0»).
CTR="my-amnezia"           # имя контейнера Amnezia
BRIDGE_IF="wg-br"          # интерфейс моста (кроме docker0)
BRIDGE_IP="172.30.100.1"   # IP моста
VPN_SUBNET="172.30.100.0/24"
AWG_IF="awg0"              # туннельный интерфейс внутри контейнера